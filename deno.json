{
  "name": "@hiisi/ante",
  "version": "0.2.3",
  "description": "Copyright headers as a maintained artifact. Checked, fixed and kept consistent across a whole tree.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli/mod.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "#core": "./core/mod.ts",
    "#git": "./git/mod.ts",
    "#cli": "./cli/mod.ts",
    "@std/toml": "jsr:@std/toml@^1.0.0"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run",
    "test:watch": "deno test --allow-read --allow-write --allow-env --allow-run --watch",
    "test:coverage": "deno test --allow-read --allow-write --allow-env --allow-run --coverage=coverage/",
    "lint": "deno run -A --config gate.json gate.ts",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts",
    "all": "deno task fmt && deno task lint && deno task check && deno task test",
    "prepublish": "deno task all && deno task test:node",
    "codegen": "deno run --allow-read --allow-write scripts/codegen.ts",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test:node": "deno task build:npm && node tests/node/smoke.mjs && node tests/node/git.mjs && npx --yes tsx tests/node/types.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "core/mod.ts",
      "core/config.ts",
      "core/config.generated.ts",
      "core/contributors.ts",
      "core/formatter.ts",
      "core/glob.ts",
      "core/header.ts",
      "core/run.ts",
      "core/version.ts",
      "git/mod.ts",
      "git/hooks.ts",
      "git/history.ts",
      "cli/mod.ts",
      "cli/commands/_files.ts",
      "cli/commands/init.ts",
      "cli/commands/check.ts",
      "cli/commands/fix.ts",
      "cli/commands/add.ts",
      "schema/config.schema.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      "scripts/",
      ".githooks/"
    ]
  },
  "ante": {
    "width": 100,
    "maxContributors": 3,
    "contributorSelection": "commits",
    "spdxLicense": "MPL-2.0",
    "licenseUrl": "https://mozilla.org/MPL/2.0"
  },
  "minimumDependencyAge": 0
}
