#!/bin/sh
# git-shook dispatcher v1
# Generated by git-shook. Do not edit: `git shook install` rewrites it.
#
# Runs every entry registered for this event, in sorted order, and stops at the
# first one that fails. `git shook list` shows what is registered.

# Sorted means one thing only if the collation is fixed. Without this the run
# order is the user's locale, which is not an order anybody can reason about.
LC_ALL=C
export LC_ALL

ev=${0##*/}

# A bare repository has no work tree, so `--show-toplevel` fails there and the
# push hooks a bare repository exists to run would be silently inert. Fall back
# to the git directory, which is where a bare repository keeps everything.
root=$(git rev-parse --show-toplevel 2>/dev/null) ||
	root=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0

d="$root/.shook/entries/$ev"
[ -d "$d" ] || exit 0

# Anything git handed us by a path relative to the current directory has to be
# made absolute before an entry is run somewhere else, or it resolves against
# the wrong directory. `GIT_INDEX_FILE` is the one that bites, because a
# program that is not git itself reads it verbatim.
if [ -n "${GIT_INDEX_FILE:-}" ]; then
	case $GIT_INDEX_FILE in
	/*) ;;
	*)
		GIT_INDEX_FILE="$(pwd)/$GIT_INDEX_FILE"
		export GIT_INDEX_FILE
		;;
	esac
fi

tmp=$(mktemp -d 2>/dev/null || mktemp -d -t git-shook) || exit 1
trap 'rm -rf "$tmp"' EXIT

: >"$tmp/stdin"
[ -t 0 ] || cat >"$tmp/stdin"
for a in "$@"; do printf '%s\n' "$a"; done >"$tmp/argv"

st=0
for e in "$d"/*; do
	[ -f "$e" ] || continue
	wd=$(head -n 1 "$e")
	tail -n +2 "$e" >"$tmp/entry"
	set --
	while IFS= read -r a; do set -- "$@" "$a"; done <"$tmp/entry"
	while IFS= read -r a; do set -- "$@" "$a"; done <"$tmp/argv"
	[ $# -gt 0 ] || continue
	( cd "$root/$wd" 2>/dev/null || exit 127; exec "$@" ) <"$tmp/stdin" || { st=$?; break; }
done
exit $st
